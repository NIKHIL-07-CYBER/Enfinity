# NLP Adaptation Layer — Environment Variables
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to version control.

# ── Translation Proxy (LibreTranslate — served by Dev D's backend) ─────────────
# URL Dev D's backend exposes for translation requests.
VITE_NLP_TRANSLATE_URL=/api/translate

# ── Dictionary API ───────────────────────────────────────────────────────────────
# Free Dictionary API base URL. Change only if you self-host a mirror.
VITE_NLP_DICT_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en

# ── Network Timeout ──────────────────────────────────────────────────────────────
# Max ms to wait for any external API call before falling back to local NLP.
VITE_NLP_API_TIMEOUT_MS=4000

# ── CFS Threshold ────────────────────────────────────────────────────────────────
# Min Comprehension Friction Score to trigger adaptation. Calibrated to 1.5.
# Increase to 1.8 if too noisy; decrease to 1.3 if too conservative.
VITE_NLP_CFS_THRESHOLD=1.5

# ── ESL Stall Count ──────────────────────────────────────────────────────────────
# Number of stalls on the same word before ESL cognate mode is activated.
VITE_NLP_ESL_STALLS=3

# ── Cognate Similarity Threshold ─────────────────────────────────────────────────
# Min Levenshtein similarity (0.0–1.0) to accept a translation as a cognate.
# 0.6 = blocks false friends while keeping genuine cognates.
VITE_NLP_COGNATE_SIM=0.6
